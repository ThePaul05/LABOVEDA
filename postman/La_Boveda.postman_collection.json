  "item": [
    {
      "name": "01 - Registrar agente 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sufijo = Date.now() + '_' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('correoAgente1', 'agente1_' + sufijo + '@ejemplo.test');",
              "pm.collectionVariables.set('correoAgente2', 'agente2_' + sufijo + '@ejemplo.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"usuarioAgente1\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "registro"
          ]
        },
        "description": "01 - Registrar agente 1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Agente Uno\",\n  \"email\": \"{{correoAgente1}}\",\n  \"password\": \"{{claveDemo}}\"\n}",
